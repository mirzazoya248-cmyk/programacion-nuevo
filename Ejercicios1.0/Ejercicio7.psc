Algoritmo Ejercicio7
	
	Definir niños, niñas, total Como Entero;
	Definir porcentaje_niños, porcentaje_niñas Como Real;
	
	Escribir "Dime el valor de niños";
	Leer niños;
	
	Escribir "Dime el valor de niñas"; 
	Leer niñas;
	
	total = niños + niñas;
	
	porcentaje_niños = (niños / total) * 100;
	porcentaje_niñas = (niñas / total) * 100;
	
	Escribir "La porcentaje de niños es " porcentaje_niños;
	Escribir "La porcentaje de niñas es " porcentaje_niñas;
	
FinAlgoritmo
